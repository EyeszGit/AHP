{
  "manifest_version": 3,
  "name": "Fiverr Candidate AHP Evaluator",
  "version": "0.1.0",
  "description": "Scrape Fiverr gig pages and rank candidates with your AHP model (Experience / Cost / Charisma) to pick the best hire.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AHP Candidate Evaluator"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.fiverr.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.fiverr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
